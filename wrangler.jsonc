{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "am-studio-pwa",
  "main": "./src/membership-runtime.js",
  "compatibility_date": "2026-08-11",
  "triggers": {
    "crons": [
      "0 11 * * *"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "COMIC_ASSETS",
      "bucket_name": "am-studio-comics"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "MEMBERSHIP_DB",
      "database_name": "am-studio-comics-membership",
      "database_id": "ba50fde4-ef67-4bb9-8446-630976c40f82",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "BILLING_ENVIRONMENT": "PRODUCTION"
  }
}
